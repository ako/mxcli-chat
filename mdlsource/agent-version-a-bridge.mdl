/**
 * The second instance of the microflow-typed-parameter problem (FINDINGS 36).
 *
 * AgentCommons.ChatContext_Create_ForAgent takes ActionMicroflow, which is
 * microflow-typed in the model, so calling it from MDL fails the same way the
 * MCP Server module's actions did:
 *
 *   [CE0115] "The arguments that are passed to Java action
 *   'AgentCommons.ChatContext_Create_ForAgent' do not match the expected
 *   parameters and need to be refreshed."
 *
 * Same shape, same fix: on the Java side the parameter is a plain
 * java.lang.String, so this action takes a string and hands it over. Two
 * independent modules hitting this in one session is the argument for teaching
 * mxcli to emit Microflows$MicroflowParameterValue rather than bridging it
 * per module.
 */
create java action MxcliChatAgent.JA_ChatContext_CreateForAgent (
  Agent: AgentCommons.Agent not null,
  ActionMicroflow: string not null
) returns ConversationalUI.ChatContext
exposed as 'New Chat for Agent (string args)' in 'MxcliChat'
as $$
// ContextObject and OverwritingDeployedModel are left null: this app has no
// context entity, and the model comes from the agent's in-use version.
return new agentcommons.actions.ChatContext_Create_ForAgent(
        getContext(),
        Agent.getMendixObject(),
        ActionMicroflow,
        null,
        null
).executeAction();
$$;
/

/**
 * Opens a new chat against the seeded agent.
 *
 * ChatContext_Create_ForAgent resolves the agent's in-use version, its deployed
 * model and its tools — including the memory MCP server — so nothing about the
 * model or the tool list is repeated here.
 *
 * The action microflow is AgentCommons' own: it is what runs when the send
 * button is clicked, and it does the request/response/tool-call loop that
 * version B will have to write by hand.
 */
create or modify microflow MxcliChatAgent.ACT_Chat_Open ()
folder 'Pages'
begin
  retrieve $Agent from AgentCommons.Agent
    where Title = 'MxcliChat Assistant'
    limit 1;

  $ChatContext = call java action MxcliChatAgent.JA_ChatContext_CreateForAgent (
    Agent = $Agent,
    ActionMicroflow = 'AgentCommons.ChatContext_ChatWithHistory_ActionMicroflow_AgentBuilder'
  );

  show page MxcliChatAgent.Chat_Agent ($ChatContext = $ChatContext);

  return;
end;
/
